/target
.claude/

# crates/drift-lint is its own detached Cargo workspace (pinned nightly),
# so its target dir isn't caught by the root /target ignore above.
crates/drift-lint/target/
# tests/reachability_fixture is its own detached workspace too (see its
# own Cargo.toml [workspace] table) — same reasoning.
crates/drift-lint/tests/reachability_fixture/target/

# bindings/csharp — standard .NET/Roslyn generated output, never committed.
bindings/csharp/**/bin/
bindings/csharp/**/obj/

# bindings/unreal/drift-unreal-lint is its own detached Cargo workspace
# (stable toolchain, but not a root-workspace member — same reasoning as
# crates/drift-lint above), so its target dir isn't caught by /target.
bindings/unreal/drift-unreal-lint/target/

# bindings/godot/drift-godot-lint — same reasoning, its own detached
# workspace.
bindings/godot/drift-godot-lint/target/

/docs/book
